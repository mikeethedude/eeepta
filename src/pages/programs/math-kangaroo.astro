    <header class="bg-pta-navy text-white py-12 px-4 text-center">
        <div class="container mx-auto max-w-4xl">
            <h1 class="text-4xl md:text-5xl font-bold text-pta-gold">Math Kangaroo</h1>
            <p class="mt-4 text-lg md:text-xl text-gray-300">More information coming soon.</p>
        </div>
    </header>

    <!-- Main Content Layout -->
    <div class="container mx-auto px-4 py-16 max-w-6xl">
        <div class="flex flex-col lg:flex-row gap-12">
        </div>
    </div>
</BaseLayout>