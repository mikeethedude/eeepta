---
// src/pages/programs/math-superstars.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout>
    <!-- Page Header -->
    <header class="bg-pta-navy text-white py-12 px-4 text-center">
        <div class="container mx-auto max-w-4xl">
            <h1 class="text-4xl md:text-5xl font-bold text-pta-gold">Math Superstars</h1>
            <p class="mt-4 text-lg md:text-xl text-gray-300">Encouraging teamwork, problem-solving, and a love for math.</p>
        </div>
    </header>

    <!-- Main Content Layout -->
    <div class="container mx-auto px-4 py-16 max-w-6xl">
        <div class="flex flex-col lg:flex-row gap-12">
            
            <!-- Sidebar: Table of Contents & Logistics -->
            <aside class="lg:w-1/3 space-y-8 flex-shrink-0">
                
                <!-- Table of Contents Card -->
                <div class="bg-white rounded-2xl shadow-lg border-t-4 border-pta-gold p-6 sticky top-8">
                    <h2 class="text-xl font-bold text-pta-navy mb-4">On this page</h2>
                    <ul class="space-y-3 text-gray-600 font-medium">
                        <li><a href="#about" class="hover:text-blue-600 transition-colors">About the Program</a></li>
                        <li><a href="#how-it-works" class="hover:text-blue-600 transition-colors">How Does It Work?</a></li>
                        <li><a href="#worksheets" class="hover:text-blue-600 transition-colors">Worksheets by Grade</a></li>
                        <li><a href="#answer-keys" class="hover:text-blue-600 transition-colors">Answer Keys</a></li>
                    </ul>
                </div>

                <!-- Key Details Card -->
                <div class="bg-blue-50 rounded-2xl p-6 border border-blue-100">
                    <h2 class="text-xl font-bold text-pta-navy mb-5">Key Details</h2>
                    <ul class="space-y-5 text-gray-700">
                        <li class="flex items-start">
                            <svg class="w-6 h-6 text-blue-500 mr-3 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                            <div><strong>Duration:</strong><br>September – March</div>
                        </li>
                        <li class="flex items-start">
                            <svg class="w-6 h-6 text-blue-500 mr-3 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            <div><strong>Final Deadline:</strong><br>March 26, 2027</div>
                        </li>
                        <li class="flex items-start">
                            <svg class="w-6 h-6 text-blue-500 mr-3 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                            <div><strong>Contact:</strong><br><a href="mailto:eee.mathsuperstars@gmail.com" class="text-blue-600 hover:underline">eee.mathsuperstars@gmail.com</a></div>
                        </li>
                    </ul>
                </div>
            </aside>

            <!-- Main Content Area -->
            <main class="lg:w-2/3 text-lg text-gray-700 leading-relaxed space-y-12">
                
                <!-- High Priority Alert -->
                <div class="bg-red-50 border-l-4 border-red-500 p-6 rounded-r-lg shadow-sm">
                    <div class="flex items-start">
                        <svg class="w-8 h-8 text-red-500 mr-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                        <div>
                            <h3 class="text-red-800 font-bold text-xl mb-1">Important Submission Rule</h3>
                            <p class="text-red-700 m-0">All worksheets <strong>MUST</strong> be turned in through the digital link below. Teachers <strong>WILL NOT</strong> accept paper copies in the classroom.</p>
                        </div>
                    </div>
                </div>

                <section id="about" class="scroll-mt-12">
                    <h2 class="text-3xl font-bold text-pta-navy mb-4 border-b-2 border-gray-100 pb-2">Welcome to Math Superstars!</h2>
                    <p class="mb-4">We are so excited you are interested in participating in this PTA-sponsored enrichment program this year! It is a completely optional program for all students attending Kindergarten through Fifth grade.</p>
                    <p class="mb-4">The goal of this program is to enhance the student’s knowledge of math. The program is great for encouraging parent/child teamwork, practicing math skills, and learning to approach problem-solving situations.</p>
                    <p>There will be an end-of-the-year fun treat for reaching the finish line and completing all 20 worksheets!</p>
                </section>

                <section id="how-it-works" class="scroll-mt-12">
                    <h2 class="text-3xl font-bold text-pta-navy mb-4 border-b-2 border-gray-100 pb-2">How Does the Program Work?</h2>
                    <ol class="list-decimal pl-6 space-y-3 mb-8 font-medium text-gray-800">
                        <li>Print the worksheets at home according to your child's grade level.</li>
                        <li>Complete one worksheet at a time.</li>
                        <li>Submit the finished worksheet using the digital link below (Only 1 worksheet per submission).</li>
                    </ol>

                    <div class="text-center py-6">
                        <a href="#" class="inline-block bg-pta-gold text-pta-navy font-bold py-4 px-8 rounded-full hover:bg-yellow-400 transition-all duration-300 shadow-lg hover:shadow-xl hover:-translate-y-1">
                            Math Superstars Submission Link
                        </a>
                    </div>

                    <div class="bg-gray-50 border-l-4 border-gray-400 p-5 rounded-r-lg mt-6">
                        <p class="text-sm md:text-base text-gray-700 m-0">
                            <strong>Note:</strong> Please remember that the program is optional and it will not be part of your child’s classroom instruction or grades.
                        </p>
                    </div>
                </section>

                <section id="worksheets" class="scroll-mt-12">
                    <h2 class="text-3xl font-bold text-pta-navy mb-4 border-b-2 border-gray-100 pb-2">Worksheets per Grade Level</h2>
                    <p class="mb-6">These files contain all 20 worksheets to make it easy to print at home. Due dates are recommendations to help keep students on track, but <strong>all worksheets must be turned in by March 26, 2027!</strong></p>
                    
                    <!-- Cleaned up Google Sheets Iframe -->
                    <div class="w-full h-[550px] rounded-xl overflow-hidden shadow-md border border-gray-200 mb-10">
                        <iframe 
                            src="https://docs.google.com/spreadsheets/d/1CCANjjjNqnHRQEGPdHoa-3yf_7BZvSEwdIUeMUW8LfQ/htmlembed?authuser=0" 
                            class="w-full h-full" 
                            title="Math Superstars Worksheets by Grade Level"
                            frameborder="0" 
                            allowfullscreen>
                        </iframe>
                    </div>
                    
                    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                        {['Kindergarten', 'First Grade', 'Second Grade', 'Third Grade', 'Fourth Grade', 'Fifth Grade'].map((grade) => (
                            <a href="#" class="flex items-center justify-center p-4 border-2 border-gray-200 rounded-xl hover:border-pta-gold hover:bg-yellow-50 text-pta-navy font-bold transition-colors text-center">
                                {grade}
                            </a>
                        ))}
                    </div>
                </section>

                <section id="answer-keys" class="scroll-mt-12">
                    <h2 class="text-3xl font-bold text-pta-navy mb-4 border-b-2 border-gray-100 pb-2">Answer Keys</h2>
                    
                    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                        {['Kindergarten', '1st Grade', '2nd Grade', '3rd Grade', '4th Grade', '5th Grade'].map((grade) => (
                            <a href="#" class="flex items-center justify-center p-4 border border-gray-200 rounded-xl hover:border-blue-500 hover:bg-blue-50 text-blue-700 font-bold transition-colors text-center">
                                {grade} Key
                            </a>
                        ))}
                    </div>
                </section>

            </main>
        </div>
    </div>
</BaseLayout>