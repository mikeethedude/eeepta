---
// src/pages/programs/spelling-bee.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout>
    <!-- Page Header -->
    <header class="bg-pta-navy text-white py-12 px-4 text-center">
        <div class="container mx-auto max-w-4xl">
            <h1 class="text-4xl md:text-5xl font-bold text-pta-gold">Spelling Bee</h1>
            <p class="mt-4 text-lg md:text-xl text-gray-300">Our annual campus-wide spelling competition.</p>
        </div>
    </header>

    <!-- Main Content Layout -->
    <div class="container mx-auto px-4 py-16 max-w-6xl">
        <div class="flex flex-col lg:flex-row gap-12">
            
            <!-- Sidebar: Table of Contents & Logistics -->
            <aside class="lg:w-1/3 space-y-8 flex-shrink-0">
                
                <!-- Table of Contents Card -->
                <div class="bg-white rounded-2xl shadow-lg border-t-4 border-pta-gold p-6 sticky top-8">
                    <h2 class="text-xl font-bold text-pta-navy mb-4">On this page</h2>
                    <ul class="space-y-3 text-gray-600 font-medium">
                        <li><a href="#about" class="hover:text-blue-600 transition-colors">About the Competition</a></li>
                        <li><a href="#timeline" class="hover:text-blue-600 transition-colors">Competition Timeline</a></li>
                        <li><a href="#registration" class="hover:text-blue-600 transition-colors">Registration & Study Info</a></li>
                    </ul>
                </div>

                <!-- Key Details Card -->
                <div class="bg-blue-50 rounded-2xl p-6 border border-blue-100">
                    <h2 class="text-xl font-bold text-pta-navy mb-5">Key Details</h2>
                    <ul class="space-y-5 text-gray-700">
                        <li class="flex items-start">
                            <svg class="w-6 h-6 text-blue-500 mr-3 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                            <div><strong>Eligibility:</strong><br>2nd, 3rd, 4th, and 5th graders</div>
                        </li>
                        <li class="flex items-start">
                            <svg class="w-6 h-6 text-blue-500 mr-3 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                            <div><strong>Registration Window:</strong><br>Sept 15th – Oct 1st</div>
                        </li>
                        <li class="flex items-start">
                            <svg class="w-6 h-6 text-blue-500 mr-3 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            <div><strong>PTA Requirement:</strong><br>None (Open to all families)</div>
                        </li>
                    </ul>
                </div>
            </aside>

            <!-- Main Content Area -->
            <main class="lg:w-2/3 text-lg text-gray-700 leading-relaxed space-y-12">
                
                <section id="about" class="scroll-mt-12">
                    <h2 class="text-3xl font-bold text-pta-navy mb-4 border-b-2 border-gray-100 pb-2">About the Spelling Bee</h2>
                    <p class="mb-4">The Elsa England PTA will be hosting a Spelling Bee this year for 2nd, 3rd, 4th, and 5th graders.</p>
                    <p>This is a fantastic opportunity for students to expand their vocabulary and showcase their hard work. Winners of the 4th and 5th-grade competition will proceed to the regional competition to represent our school!</p>
                </section>

                <section id="timeline" class="scroll-mt-12">
                    <h2 class="text-3xl font-bold text-pta-navy mb-6 border-b-2 border-gray-100 pb-2">Competition Timeline</h2>
                    
                    <div class="space-y-6">
                        <!-- Round 1 -->
                        <div class="flex flex-col md:flex-row gap-4 bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
                            <div class="md:w-1/4 font-bold text-blue-700 text-xl">November</div>
                            <div class="md:w-3/4">
                                <h3 class="font-bold text-pta-navy mb-1">Round 1</h3>
                                <p class="text-gray-600 m-0">A written test given in each participating student's classroom. The highest-scoring students will advance to the next round.</p>
                            </div>
                        </div>

                        <!-- Semi-Finals -->
                        <div class="flex flex-col md:flex-row gap-4 bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
                            <div class="md:w-1/4 font-bold text-blue-700 text-xl">December</div>
                            <div class="md:w-3/4">
                                <h3 class="font-bold text-pta-navy mb-1">Semi-Finals</h3>
                                <p class="text-gray-600 m-0">Another written test given in the library for our top-scoring students from Round 1.</p>
                            </div>
                        </div>

                        <!-- Finals -->
                        <div class="flex flex-col md:flex-row gap-4 bg-yellow-50 border border-pta-gold rounded-xl p-6 shadow-sm">
                            <div class="md:w-1/4 font-bold text-[#d99f00] text-xl">January</div>
                            <div class="md:w-3/4">
                                <h3 class="font-bold text-pta-navy mb-1">Finals</h3>
                                <p class="text-gray-800 m-0">A live verbal competition held on the cafeteria stage to crown our spelling champions!</p>
                            </div>
                        </div>
                    </div>
                </section>

                <section id="registration" class="scroll-mt-12 pt-6 border-t border-gray-100">
                    <div class="bg-pta-navy rounded-2xl p-8 text-center text-white shadow-xl">
                        <h2 class="text-2xl md:text-3xl font-bold mb-4 text-pta-gold">Ready to Compete?</h2>
                        <p class="mb-6 text-gray-200">Register your student by filling out the official form. Registrations are strictly open from <strong>September 15th to October 1st</strong>.</p>
                        
                        <a href="#" class="inline-block bg-pta-gold text-pta-navy font-bold py-3 px-8 rounded-full hover:bg-yellow-400 hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1">
                            Registration coming soon!
                        </a>
                        
                        <p class="mt-6 text-sm text-gray-400">
                            <strong>Note:</strong> The official study word list will be provided to all participants after registration closes.
                        </p>
                    </div>
                </section>

            </main>
        </div>
    </div>
</BaseLayout>