---
// src/pages/programs/math-pentathlon.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout>
    <!-- Page Header -->
    <header class="bg-pta-navy text-white py-12 px-4 text-center">
        <div class="container mx-auto max-w-4xl">
            <h1 class="text-4xl md:text-5xl font-bold text-pta-gold">Math Pentathlon</h1>
            <p class="mt-4 text-lg md:text-xl text-gray-300">Strengthening math thinking through strategy and games.</p>
        </div>
    </header>

    <!-- Main Content Layout -->
    <div class="container mx-auto px-4 py-16 max-w-6xl">
        <div class="flex flex-col lg:flex-row gap-12">
            
            <!-- Sidebar: Table of Contents & Logistics -->
            <aside class="lg:w-1/3 space-y-8 flex-shrink-0">
                
                <!-- Table of Contents Card -->
                <div class="bg-white rounded-2xl shadow-lg border-t-4 border-pta-gold p-6 sticky top-8">
                    <h2 class="text-xl font-bold text-pta-navy mb-4">On this page</h2>
                    <ul class="space-y-3 text-gray-600 font-medium">
                        <li><a href="#welcome" class="hover:text-blue-600 transition-colors">Welcome</a></li>
                        <li><a href="#what-is-it" class="hover:text-blue-600 transition-colors">What is Math Pentathlon?</a></li>
                        <li><a href="#tournaments" class="hover:text-blue-600 transition-colors">Tournaments</a></li>
                        <li><a href="#results" class="hover:text-blue-600 transition-colors">Results</a></li>
                        <li><a href="#additional-links" class="hover:text-blue-600 transition-colors">Additional Links</a></li>
                    </ul>
                </div>

                <!-- Club Details Card -->
                <div class="bg-blue-50 rounded-2xl p-6 border border-blue-100">
                    <h2 class="text-xl font-bold text-pta-navy mb-5">Club Details</h2>
                    <ul class="space-y-5 text-gray-700">
                        <li class="flex items-start">
                            <svg class="w-6 h-6 text-blue-500 mr-3 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                            <div><strong>Start Date:</strong><br>Oct 25, 2025</div>
                        </li>
                        <li class="flex items-start">
                            <svg class="w-6 h-6 text-blue-500 mr-3 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            <div><strong>When:</strong><br>Every Wednesday<br>5:30 PM – 6:30 PM</div>
                        </li>
                        <li class="flex items-start">
                            <svg class="w-6 h-6 text-blue-500 mr-3 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                            <div><strong>Where:</strong><br>Grade-level common areas</div>
                        </li>
                    </ul>
                </div>

            </aside>

            <!-- Main Content Area -->
            <main class="lg:w-2/3 text-lg text-gray-700 leading-relaxed space-y-12">
                
                <section id="welcome" class="scroll-mt-12">
                    <h2 class="text-3xl font-bold text-pta-navy mb-4 border-b-2 border-gray-100 pb-2">Welcome to the Math Pentathlon Club at Elsa England!</h2>
                    <p>Our PTA is proud to offer the Math Pentathlon Club—an engaging opportunity for students to strengthen their math thinking skills through fun, strategic games.</p>
                </section>

                <section id="what-is-it" class="scroll-mt-12">
                    <h2 class="text-3xl font-bold text-pta-navy mb-4 border-b-2 border-gray-100 pb-2">What is Math Pentathlon?</h2>
                    <p>Math Pentathlon is a nationally recognized program that uses five challenging and fun board games to develop problem-solving, logical reasoning, and strategic thinking. The games are designed for different grade levels and align with national math standards, making learning both educational and enjoyable. Students learn by playing, collaborating, and competing in a supportive environment that fosters confidence and a love for math!</p>
                </section>

                <section id="tournaments" class="scroll-mt-12">
                    <h2 class="text-3xl font-bold text-pta-navy mb-4 border-b-2 border-gray-100 pb-2">Tournaments</h2>
                    <p class="mb-4">Each year, the Math Pentathlon Institute organizes regional tournaments, where students from participating schools come together to compete and showcase their skills in a supportive and exciting environment.</p>
                    <p class="mb-6">More information can be found at <a href="https://www.mathpentath.org/" target="_blank" rel="noopener noreferrer" class="text-blue-600 font-medium hover:underline">www.mathpentath.org</a>.</p>
                    
                    <div class="bg-yellow-50 border-l-4 border-pta-gold p-5 rounded-r-lg">
                        <p class="text-sm md:text-base text-gray-800 m-0">
                            <strong>Note:</strong> To ensure a successful and enjoyable experience for all participants, please review the club guidelines before registering.
                        </p>
                    </div>
                </section>

                <section id="results" class="scroll-mt-12">
                    <h2 class="text-3xl font-bold text-pta-navy mb-4 border-b-2 border-gray-100 pb-2">Results</h2>
                    <ul class="list-disc pl-6 space-y-2 text-blue-600 font-medium">
                        <li><a href="#" class="hover:underline">2025 Results</a></li>
                        <li><a href="#" class="hover:underline">2024 Results</a></li>
                    </ul>
                </section>

                <section id="additional-links" class="scroll-mt-12">
                    <h2 class="text-3xl font-bold text-pta-navy mb-4 border-b-2 border-gray-100 pb-2">Additional Links</h2>
                    <div class="flex flex-col gap-3">
                        <a href="https://www.mathpentath.org/game-information-sheets/" target="_blank" rel="noopener noreferrer" class="flex items-center p-4 border border-gray-200 rounded-lg hover:border-blue-500 hover:bg-blue-50 transition-colors group">
                            <span class="font-bold text-pta-navy group-hover:text-blue-700">Game Highlight Sheets</span>
                            <span class="text-gray-500 ml-2 text-sm">(with latest rules overview)</span>
                        </a>
                        <a href="https://www.mathpentath.org/austin-area/" target="_blank" rel="noopener noreferrer" class="flex items-center p-4 border border-gray-200 rounded-lg hover:border-blue-500 hover:bg-blue-50 transition-colors group">
                            <span class="font-bold text-pta-navy group-hover:text-blue-700">Tournament Information, Austin Area</span>
                            <span class="text-gray-500 ml-2 text-sm">(fees and dates)</span>
                        </a>
                        <a href="https://www.mathpentath.org/product-category/games/" target="_blank" rel="noopener noreferrer" class="flex items-center p-4 border border-gray-200 rounded-lg hover:border-blue-500 hover:bg-blue-50 transition-colors group">
                            <span class="font-bold text-pta-navy group-hover:text-blue-700">Official Store</span>
                            <span class="text-gray-500 ml-2 text-sm">(game sets for purchase)</span>
                        </a>
                    </div>
                </section>

            </main>
        </div>
    </div>
</BaseLayout>