---
// src/pages/get-involved/homeroom-parents.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout>
    <!-- Page Header -->
    <header class="bg-pta-navy text-white py-12 px-4 text-center">
        <div class="container mx-auto max-w-4xl">
            <h1 class="text-4xl md:text-5xl font-bold text-pta-gold">Homeroom Parents</h1>
            <p class="mt-4 text-lg md:text-xl text-gray-300">Essential resources and links for our classroom volunteers.</p>
        </div>
    </header>

    <!-- Main Content -->
    <div class="container mx-auto px-4 py-16 max-w-3xl">
        <div class="bg-white rounded-2xl shadow-xl p-8 md:p-12 text-lg text-gray-700 leading-relaxed space-y-8">
            
            <p class="text-center font-medium text-pta-navy text-xl border-b border-gray-100 pb-8">
                Thank you for stepping up to be a Homeroom Parent! Below you will find the useful links you need to support your classroom this year.
            </p>

            <!-- Big Clickable Resource Cards -->
            <div class="flex flex-col gap-5">
                
                <!-- Staff Favorites Link -->
                <a href="#" target="_blank" rel="noopener noreferrer" class="flex flex-col sm:flex-row items-start sm:items-center p-6 border border-gray-200 rounded-xl hover:border-blue-500 hover:bg-blue-50 transition-all duration-300 group shadow-sm hover:shadow-md">
                    <div class="bg-blue-100 p-4 rounded-full text-blue-600 mr-5 mb-4 sm:mb-0 group-hover:scale-110 transition-transform flex-shrink-0">
                        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
                    </div>
                    <div>
                        <span class="block font-bold text-pta-navy group-hover:text-blue-700 text-xl mb-1">2025-26 England Staff Favorites</span>
                        <span class="text-gray-600 text-base leading-snug block">Spreadsheet includes ideas for teacher gifts and links to classroom wishlists.</span>
                    </div>
                </a>

                <!-- Reimbursement Link -->
                <a href="#" target="_blank" rel="noopener noreferrer" class="flex flex-col sm:flex-row items-start sm:items-center p-6 border border-gray-200 rounded-xl hover:border-pta-gold hover:bg-yellow-50 transition-all duration-300 group shadow-sm hover:shadow-md">
                    <div class="bg-yellow-100 p-4 rounded-full text-[#d99f00] mr-5 mb-4 sm:mb-0 group-hover:scale-110 transition-transform flex-shrink-0">
                        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                    </div>
                    <div>
                        <span class="block font-bold text-pta-navy group-hover:text-[#d99f00] text-xl mb-1">2025-26 Reimbursement Request Form</span>
                        <span class="text-gray-600 text-base leading-snug block">For Homeroom Parents requesting reimbursement from the PTA for eligible payments made out-of-pocket.</span>
                    </div>
                </a>

            </div>

            <!-- Contact Section -->
            <div class="bg-gray-50 border-l-4 border-pta-navy p-6 rounded-r-lg mt-8">
                <h3 class="font-bold text-pta-navy mb-1">Have Questions?</h3>
                <p class="m-0 text-base text-gray-700">
                    Email <a href="mailto:englandhrp@gmail.com" class="text-blue-600 font-bold hover:underline">englandhrp@gmail.com</a> with any questions.
                </p>
            </div>

        </div>
    </div>
</BaseLayout>