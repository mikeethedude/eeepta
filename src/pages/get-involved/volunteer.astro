---
// src/pages/get-involved/volunteer.astro
import BaseLayout from '../../layouts/BaseLayout.astro';

// Array of corporate matching links for easy updating later
const matchingCompanies = [
  { name: "Apple", url: "https://apple.benevity.org/user/login" },
  { name: "Dell", url: "http://dell.benevity.org" },
  { name: "Charles Schwab", url: "https://schwabgives.benevity.org/user/login" },
  { name: "Expedia", url: "https://expediacares.benevity.org/user/login" },
  { name: "Google", url: "https://google.benevity.org/user/login" },
  { name: "Home Depot", url: "https://www.cybergrants.com/homedepot/" },
  { name: "HP", url: "https://hp.benevity.org/user/login" },
  { name: "Microsoft", url: "http://microsoft.benevity.org" },
  { name: "Nvidia", url: "http://nvidia.benevity.org" },
  { name: "Paypal", url: "https://paypal.benevity.org/user/login" },
  { name: "Visa", url: "https://visa.benevity.org/user/login" }
];
---

<BaseLayout>
    <!-- Page Header -->
    <header class="bg-pta-navy text-white py-12 px-4 text-center">
        <div class="container mx-auto max-w-4xl">
            <h1 class="text-4xl md:text-5xl font-bold text-pta-gold">Volunteer With Us</h1>
            <p class="mt-4 text-lg md:text-xl text-gray-300">Your time and talents make a big impact.</p>
        </div>
    </header>

    <!-- Main Content -->
    <div class="container mx-auto px-4 py-16 max-w-4xl space-y-12">
        
        <!-- Welcome & Intro Section -->
        <div class="bg-white rounded-2xl shadow-xl p-8 md:p-12 text-lg text-gray-700 leading-relaxed text-center">
            <h2 class="text-3xl font-bold text-pta-navy mb-6">Welcome to the PTA Volunteer Page!</h2>
            <p class="mb-6">
                We are so glad you are here! We appreciate your interest in volunteering at school. We believe that great things happen when parents, teachers, and students work together. 
            </p>
            <p class="mb-10">
                By volunteering with us, you’re helping to create an amazing school experience for our kids, while building a stronger community. Whether you can spare an hour or are available for ongoing commitments, your time and talents make a big impact!
            </p>

            <a href="#" class="inline-block bg-pta-gold text-pta-navy font-bold py-4 px-10 rounded-full hover:bg-yellow-400 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 text-lg">
                Submit Volunteer Interest Form
            </a>
        </div>

        <!-- Corporate Matching Section -->
        <div class="bg-blue-50 border-t-4 border-blue-500 rounded-2xl shadow-md p-8 md:p-12">
            <div class="text-center mb-10">
                <h2 class="text-3xl font-bold text-pta-navy mb-4">Double Your Impact</h2>
                <p class="text-gray-700 max-w-2xl mx-auto">
                    Did you know your volunteer hours could turn into direct funding for our school? We work with Benevity and other matching programs at many prominent employers in our area. Click your company below to log your hours!
                </p>
            </div>

            <!-- Company Grid -->
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                {matchingCompanies.map((company) => (
                    <a href={company.url} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center p-4 bg-white border border-gray-200 rounded-xl hover:border-blue-500 hover:shadow-md text-pta-navy font-bold transition-all text-center text-sm md:text-base group">
                        <span class="group-hover:text-blue-600 transition-colors">{company.name}</span>
                    </a>
                ))}
            </div>
            
            <p class="text-center text-sm text-gray-500 mt-8 italic">
                Don't see your company? Check with your HR department to see if they offer a volunteer matching program!
            </p>
        </div>

    </div>
</BaseLayout>