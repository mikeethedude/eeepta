---
// src/pages/announcements.astro
import BaseLayout from '../layouts/BaseLayout.astro';

// 1. Fetch all markdown files using Vite's native glob
const rawPosts = import.meta.glob('../data/announcements/*.md', { eager: true });
const allAnnouncements = Object.values(rawPosts);

// 2. Sort them by date (newest first)
const sortedAnnouncements = allAnnouncements.sort((a: any, b: any) => 
    new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf()
);
---

<BaseLayout>
    <!-- Page Header -->
    <header class="bg-[rgb(30,28,55)] text-white py-12 px-4 text-center">
        <div class="container mx-auto max-w-4xl">
            <h1 class="text-4xl md:text-5xl font-bold text-[#fbbd08]">Announcements</h1>
            <p class="mt-4 text-lg md:text-xl text-gray-300">The latest and greatest.</p>
        </div>
    </header>

    <!-- Main Content -->
    <div class="container mx-auto px-4 py-16 max-w-3xl space-y-10">
        
        {sortedAnnouncements.map((post: any) => (
            <article class="bg-white rounded-2xl shadow-xl p-8 md:p-12 border-t-4 border-[#fbbd08]">
                
                <!-- Header pulled from Markdown Frontmatter -->
                <header class="mb-6 pb-6 border-b border-gray-100">
                    <h2 class="text-3xl font-bold text-[rgb(30,28,55)] mb-2">
                        {post.frontmatter.title}
                    </h2>
                    <time class="text-sm font-medium text-gray-500 uppercase tracking-wider">
                        {new Date(post.frontmatter.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                    </time>
                </header>
                
                <!-- The dynamically rendered Markdown Content -->
                <div class="text-lg text-gray-700 leading-relaxed 
                            [&>p]:mb-6 
                            [&>ul]:list-none [&>ul]:pl-0 [&>ul]:mb-6 [&>ul>li]:mb-3
                            [&>ol]:list-decimal [&>ol]:pl-6 [&>ol]:mb-6 [&>ol>li]:mb-2
                            [&>h3]:text-2xl [&>h3]:font-bold [&>h3]:text-[rgb(30,28,55)] [&>h3]:mb-4
                            [&_a]:text-blue-600 [&_a]:underline [&_a]:font-medium hover:[&_a]:text-blue-800
                            [&_strong]:text-[rgb(30,28,55)] [&_hr]:my-8 [&_hr]:border-gray-200">
                    <post.default />
                </div>
                
            </article>
        ))}

    </div>
</BaseLayout>