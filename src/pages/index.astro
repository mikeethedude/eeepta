---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import CalendarEmbed from '../components/CalendarEmbed.astro';
import QuickLinks from '../components/QuickLinks.astro';
import LeopardHero from '../../leopardlogo.png';
---

<BaseLayout>
    <!-- Hero Section -->
    <header class="bg-[rgb(30,28,55)] text-white py-16 px-4 text-center">
        <div class="container mx-auto max-w-4xl">
            
            <!-- Accessible, visually hidden H1 -->
            <h1 class="sr-only">Welcome to Elsa England PTA. Together, every child can flourish.</h1>
            
            <!-- Hero Image pulled directly from /public -->
            <img src="/leopardlogo.png" alt="Elsa England PTA Leopards logo and welcome message" class="mx-auto max-w-full h-auto mb-8 drop-shadow-xl">
            
            <!-- Action Buttons -->
            <div class="flex flex-col sm:flex-row justify-center gap-4 mt-8">
                <!-- Drop your Zeffy link in the href below -->
                <a href="#" class="bg-[#fbbd08] text-[rgb(30,28,55)] font-bold py-3 px-8 rounded-full hover:bg-yellow-400 transition shadow-lg">Donate via Zeffy</a>
                
                <a href="https://www.zeffy.com/en-US/ticketing/823d1459-17e1-44cc-b5b4-ead0c4fe182d" class="bg-white text-[rgb(30,28,55)] font-bold py-3 px-8 rounded-full hover:bg-gray-200 transition shadow-lg">PTA Store</a>
            </div>
        </div>
    </header>

    <!-- Main Content: Calendar & Resources -->
    <div class="container mx-auto px-4 py-16 max-w-6xl">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            
            <!-- Calendar Column -->
            <div class="lg:col-span-2">
                <h2 class="text-3xl font-bold mb-6 text-[rgb(30,28,55)] border-b-4 border-[#fbbd08] inline-block pb-2">Upcoming Events</h2>
                <CalendarEmbed />
            </div>

            <!-- Quick Links Column -->
            <div class="lg:col-span-1">
                <h2 class="text-3xl font-bold mb-6 text-[rgb(30,28,55)] border-b-4 border-[#fbbd08] inline-block pb-2">Quick Links</h2>
                <QuickLinks />
            </div>

        </div>
    </div>
</BaseLayout>