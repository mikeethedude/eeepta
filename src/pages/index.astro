---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import CalendarEmbed from '../components/CalendarEmbed.astro';
import QuickLinks from '../components/QuickLinks.astro';
import leopardSingle from "../../public/frontlogo.png";
import { Image } from 'astro:assets';
---

<BaseLayout>
    <!-- Hero Section -->
    <header class="bg-pta-navy text-white py-16 px-4 text-center">
        <div class="container mx-auto max-w-4xl flex flex-col items-center">
            
            <!-- Hero Image -->
            <Image src={leopardSingle} loading="eager" alt="Elsa England Elementary Logo" width="200" class="mx-auto mb-6 drop-shadow-2xl" />
            
            <!-- Restyled Typography -->
            <h1 class="text-4xl md:text-5xl font-extrabold text-pta-gold tracking-tight mb-3">
                Welcome to Elsa England PTA
            </h1>
            <span class="text-xl md:text-2xl text-gray-300 font-light tracking-wide mb-8 block">
                Together, every child can flourish.
            </span> 
            
            <!-- Action Buttons -->
            <div class="flex flex-col sm:flex-row justify-center gap-4 w-full sm:w-auto">
                <!-- Donate Link -->
                <a href="https://www.zeffy.com/en-US/peer-to-peer/donate-to-make-a-difference-9141" class="bg-pta-gold text-pta-navy font-bold py-3 px-8 rounded-full hover:bg-yellow-400 transition-all duration-300 shadow-lg hover:shadow-xl hover:-translate-y-1">Donate via Zeffy</a>
                
                <!-- PTA Store Link -->
                <a href="https://www.zeffy.com/en-US/ticketing/elsa-england-leopards-store-26--27" class="bg-white text-pta-navy font-bold py-3 px-8 rounded-full hover:bg-gray-200 transition-all duration-300 shadow-lg hover:shadow-xl hover:-translate-y-1">PTA Store</a>
            </div>
            
        </div>
    </header>

    <!-- Main Content: Calendar & Resources -->
    <div class="container mx-auto px-4 py-16 max-w-6xl">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            
            <!-- Calendar Column -->
            <div class="lg:col-span-2">
                <h2 class="text-3xl font-bold mb-6 text-pta-navy border-b-4 border-pta-gold inline-block pb-2">Upcoming Events</h2>
                <CalendarEmbed />
            </div>

            <!-- Quick Links Column -->
            <div class="lg:col-span-1">
                <h2 class="text-3xl font-bold mb-6 text-pta-navy border-b-4 border-pta-gold inline-block pb-2">Quick Links</h2>
                <QuickLinks />
            </div>

        </div>
    </div>
</BaseLayout>