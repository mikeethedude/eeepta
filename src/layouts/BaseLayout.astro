---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Elsa England Elementary PTA</title>

    <!-- Standard Open Graph (Facebook, LinkedIn, iMessage) -->
    <meta property="og:title" content="Elsa England Elementary PTA">
    <meta property="og:description" content="Together, every child can flourish. Join the Elsa England PTA today!">
    <meta property="og:image" content="https://www.elsaenglandpta.org/elsaenglandpta.png">
    <meta property="og:url" content="https://www.elsaenglandpta.org/">

    <!-- Twitter/X specific tags (They like things their own way) -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Elsa England Elementary PTA">
    <meta name="twitter:description" content="Together, every child can flourish. Join the Elsa England PTA today!">
    <meta name="twitter:image" content="https://www.elsaenglandpta.org/elsaenglandpta.png">
</head>
<body class="bg-gray-50 text-gray-800 font-sans flex flex-col min-h-screen">
    
    <Navigation />

    <!-- The individual page content gets injected right here -->
    <main class="flex-grow">
        <slot /> 
    </main>

    <Footer />

</body>
</html>