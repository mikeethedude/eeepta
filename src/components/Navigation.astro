---
// src/components/Navigation.astro
import { Image } from 'astro:assets';
import leopardSingle from "../../public/England_Logo.png";
---
<nav class="bg-[rgb(30,28,55)] text-white shadow-md relative z-50">
  <div class="container mx-auto px-4 max-w-6xl">
    <div class="flex justify-between items-center py-4">
      
      <!-- Brand / Home Link -->
      <a href="/" class="flex items-center gap-3 text-xl font-bold tracking-wide text-white hover:text-[#fbbd08] transition-colors duration-300">
       <Image src={leopardSingle} alt="Elsa England PTA Logo" width="60"/>
       Elsa England PTA
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex space-x-8 items-center font-medium text-sm">
        
        <!-- Dropdown: Events -->
        <div class="relative group">
          <button class="flex items-center gap-1 py-2 hover:text-[#fbbd08] transition-colors duration-300">
            Events
            <!-- Chevron Icon -->
            <svg class="w-4 h-4 transition-transform duration-300 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          
          <!-- Dropdown Panel -->
          <div class="absolute left-0 mt-2 w-56 bg-white text-gray-800 rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform origin-top-left scale-95 group-hover:scale-100">
            <div class="py-2 border border-gray-100 rounded-lg">
              <a href="/events/calendar" class="block px-4 py-2 text-sm hover:bg-gray-50 hover:text-[rgb(30,28,55)] transition-colors">Calendar</a>
              <a href="/events/spring-picnic" class="block px-4 py-2 text-sm hover:bg-gray-50 hover:text-[rgb(30,28,55)] transition-colors">Spring Picnic</a>
              <a href="/events/spooky-fun-run" class="block px-4 py-2 text-sm hover:bg-gray-50 hover:text-[rgb(30,28,55)] transition-colors">Spooky Fun Run</a>
            </div>
          </div>
        </div>

        <!-- Standard Links -->
        <a href="/programs" class="hover:text-[#fbbd08] transition-colors duration-300">Programs</a>
        <a href="/get-involved" class="hover:text-[#fbbd08] transition-colors duration-300">Get Involved</a>
        <a href="/membership" class="hover:text-[#fbbd08] transition-colors duration-300">Membership</a>
        
        <!-- Store/Donate CTA -->
        <a href="https://www.zeffy.com/en-US/ticketing/823d1459-17e1-44cc-b5b4-ead0c4fe182d" class="bg-[#fbbd08] text-[rgb(30,28,55)] px-5 py-2 rounded-full font-bold hover:bg-yellow-400 hover:shadow-lg transition-all duration-300 transform hover:-translate-y-0.5">
          PTA Store
        </a>
      </div>

      <!-- Mobile Menu Toggle (Hamburger) -->
      <button id="mobile-menu-btn" class="md:hidden text-white hover:text-[#fbbd08] focus:outline-none">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>

    </div>
  </div>

  <!-- Mobile Menu Panel (Hidden by default) -->
  <div id="mobile-menu" class="hidden md:hidden bg-[rgb(25,23,45)] border-t border-[rgb(45,43,70)]">
     <!-- Mobile links would go here -->
  </div>
</nav>