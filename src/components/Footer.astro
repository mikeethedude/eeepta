---
const currentYear = new Date().getFullYear();
---

<footer class="bg-pta-navy text-gray-300 py-10 mt-auto border-t-4 border-pta-gold">
    <div class="container mx-auto px-4 text-center max-w-4xl">
        
        <!-- Mission Statement -->
        <p class="text-base md:text-lg leading-relaxed mb-6 font-medium text-white">
            England Elementary PTA is an independent, non-profit organization whose mission is to support the staff and students of Elsa England Elementary School.
        </p>
        
        <!-- Subtle Divider -->
        <div class="w-16 h-1 bg-gray-600 mx-auto mb-6 rounded-full opacity-50"></div>
        
        <!-- Copyright & Legals -->
        <p class="text-sm text-gray-400">
            &copy; {currentYear} Elsa England PTA. All rights reserved.
        </p>
        <p class="text-sm text-gray-400">Elsa England PTA (PTA TEXAS CONGRESS) is a registered 501(c)(3) organization.</p>
        <p class="text-sm text-gray-400">8801 Pearson Ranch Road, Austin, TX 78717, United States</p>
        <p class="text-sm text-gray-400">EIN: 45-5085590</p>
        
    </div>
</footer>